#!/bin/sh
# Run the local CI pipeline before a push leaves this machine.
# Enable once per clone:  git config core.hooksPath .githooks
#
# The pipeline checks the working tree you are in, so push from the branch
# you are pushing. `git push --no-verify` skips it.
top=$(git rev-parse --show-toplevel)
# Git exports GIT_DIR and related variables to hooks. The pipeline must not
# inherit them: tests run git in scratch directories, and with these set
# those commands would act on this repository.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
exec "$top/scripts/ci.sh"
